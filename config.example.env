# Database Configuration
DB_TYPE=postgres                          # Database type: postgres or mysql
DB_HOST=localhost                         # Database host
DB_PORT=5432                             # Database port (5432 for PostgreSQL, 3306 for MySQL)
DB_USER=postgres                         # Database user
DB_PASSWORD=yourpassword                 # Database password
DB_NAME=yourdatabase                     # Database name(s) - comma-separated for multiple: "db1,db2,db3"

# Security Settings
DB_READONLY=false                        # Enable read-only mode (true/false)
ALLOW_RAW_QUERY=false                    # Enable raw SQL queries - DANGEROUS! (true/false)

# Query Limits
MAX_SELECT_LIMIT=1000                    # Maximum rows returned by SELECT queries
MAX_UPDATE_LIMIT=1                       # Maximum rows updated in single UPDATE query
MAX_DELETE_LIMIT=1                       # Maximum rows deleted in single DELETE query

# SSL/TLS Configuration (RECOMMENDED FOR PRODUCTION)
# PostgreSQL SSL Modes: disable, require, verify-ca, verify-full
# Default: require (SSL enabled without certificate verification)
DB_SSLMODE=require

# MySQL TLS Modes: true, false, skip-verify, preferred
# Default: true (TLS required)
DB_TLS=true

# Optional: Client Certificate Authentication (mutual TLS)
# Uncomment and set paths for mTLS authentication
#DB_SSLCERT=/path/to/client-cert.pem
#DB_SSLKEY=/path/to/client-key.pem
#DB_SSLROOTCERT=/path/to/ca-cert.pem

# Example: Disable SSL for local development (NOT RECOMMENDED FOR PRODUCTION)
# PostgreSQL:
# DB_SSLMODE=disable
# MySQL:
# DB_TLS=false

# Example: Production with full SSL verification
# PostgreSQL:
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/ssl/certs/ca-bundle.crt
# MySQL:
# DB_TLS=true

